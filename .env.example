# Backend: local preview only by default. Use HTTPS reverse proxy for a device.
HOST=127.0.0.1
PORT=8787
# urllib or curl. curl is useful on macOS when Python's TLS runtime cannot connect.
JMA_HTTP_CLIENT=curl
# These secrets belong on your server, never inside the AIX package.
ROKID_SK=
ROKID_AGENT_ID=
ROKID_ACCOUNT_ID=
